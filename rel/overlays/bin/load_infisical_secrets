#!/bin/sh
# Sourced by the start script. When an Infisical machine identity is
# configured, re-runs the start script under `infisical run` so migrations
# and the release both start with the project's secrets in their
# environment. Infisical's values replace any variable of the same name, so
# before re-running it lists the names in each folder and refuses to start
# unless every one is in infisical_allowed (or is an INFISICAL_CANARY_
# name); everything else, including non-secret settings, stays a host
# variable. The re-run then checks that no other variable changed between
# that listing and the fetch, which leaves one assumption: a name such as
# LD_PRELOAD slipped in between the two acts when the CLI starts the shell,
# before that check, so it would also need a file already on disk.
# With nothing configured, it returns and the start script carries on as
# before. Configuring only part of it is refused, so a deploy that was meant
# to read Infisical fails its health check instead of starting without it.
#
# INFISICAL_PATHS (optional, space-separated, default "/") lists the folders
# to read, for example "/shared /core". A missing folder makes the CLI fail,
# and one the identity may not read comes back empty; either stops the
# start, since every folder holds a canary. Values are taken literally
# (--expand=false). The CLI's --watch is never used: it restarts the app on
# any change, without overlap.

infisical_allowed="VAULT_KEY VAULT_KEY_OLD SECRET_KEY_BASE EDGE_SHARED_SECRET HONEYCOMB_API_KEY MET_OFFICE_OBS_API_KEY AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY"

infisical_settings="INFISICAL_UNIVERSAL_AUTH_CLIENT_ID INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET INFISICAL_PROJECT_ID INFISICAL_ENV"

infisical_allowed_name() {
  case "$1" in
    "" | [!ABCDEFGHIJKLMNOPQRSTUVWXYZ]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*) return 1 ;;
    INFISICAL_CANARY_*) return 0 ;;
  esac
  case " $infisical_allowed " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

infisical_env_digest() {
  awk -v allowed="$infisical_allowed" 'BEGIN {
    split("_ PWD OLDPWD SHLVL " allowed, skip, " ")
    for (i in skip) skipped[skip[i]] = 1
    n = 0
    for (name in ENVIRON) {
      if (name in skipped) continue
      if (name ~ /^INFISICAL_CANARY_[ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*$/) continue
      names[++n] = name ""
    }
    if (n == 0) exit 1
    for (i = 2; i <= n; i++) {
      name = names[i]
      for (j = i - 1; j > 0 && names[j] > name; j--) names[j + 1] = names[j]
      names[j + 1] = name
    }
    for (i = 1; i <= n; i++) printf "%s=%d:%s\n", names[i], length(ENVIRON[names[i]]), ENVIRON[names[i]]
  }' | sha256sum | cut -d " " -f 1
}

infisical_digest_usable() {
  [ ${#1} -eq 64 ] && [ "$1" != e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ] || {
    echo "Could not take a digest of the environment with awk and sha256sum." >&2
    exit 1
  }
}

infisical_count() {
  printf '%s\n' "$1" | grep -o "$2" | wc -l | tr -d " "
}

if [ -n "${INFISICAL_SECRETS_LOADED:-}" ]; then
  if [ -z "${INFISICAL_TOKEN:-}" ]; then
    echo "INFISICAL_SECRETS_LOADED is set, but these secrets did not come from Infisical. Remove it from the environment." >&2
    exit 1
  fi

  case "${1:-}" in
    --infisical-env-digest=*)
      infisical_expected_digest=${1#--infisical-env-digest=}
      shift
      ;;
    *)
      echo "INFISICAL_SECRETS_LOADED is set, but the start script was not re-run by this loader. Remove it from the environment." >&2
      exit 1
      ;;
  esac
  infisical_digest=$(infisical_env_digest)
  infisical_digest_usable "$infisical_digest"
  if [ "$infisical_digest" != "$infisical_expected_digest" ]; then
    echo "A variable that Infisical may not set changed between listing the secret names and loading them. Check the Infisical audit log." >&2
    exit 1
  fi

  infisical_canaries=$(env | sed -n 's/^\(INFISICAL_CANARY_[A-Za-z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ')
  echo "Secrets loaded from Infisical. Canaries present: ${infisical_canaries:-none}"
else
  infisical_set=0
  for name in $infisical_settings; do
    eval "value=\${$name:-}"
    if [ -n "$value" ]; then infisical_set=$((infisical_set + 1)); fi
  done

  if [ "$infisical_set" -gt 0 ]; then
    if [ "$infisical_set" -lt 4 ]; then
      echo "Infisical is only partly configured. Set all of: $infisical_settings, or none of them." >&2
      exit 1
    fi

    set -f
    infisical_project_args="--projectId=$INFISICAL_PROJECT_ID --env=$INFISICAL_ENV --expand=false --silent --telemetry=false"
    infisical_path_args=""
    for infisical_path in ${INFISICAL_PATHS:-/}; do
      infisical_path_args="$infisical_path_args --path=$infisical_path"
    done

    echo "Loading secrets from Infisical..."
    INFISICAL_TOKEN=$(infisical login --method=universal-auth --silent --plain --telemetry=false)
    if [ -z "$INFISICAL_TOKEN" ]; then
      echo "Infisical sign-in returned no token." >&2
      exit 1
    fi
    export INFISICAL_TOKEN

    infisical_refused=0
    for infisical_path in ${INFISICAL_PATHS:-/}; do
      # shellcheck disable=SC2086
      if ! infisical_secrets=$(infisical export $infisical_project_args --path="$infisical_path" --format=json); then
        echo "Could not list the secrets in Infisical folder $infisical_path." >&2
        exit 1
      fi
      infisical_names=$(printf '%s\n' "$infisical_secrets" |
        grep -o '"key"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/"$//; s/.*"//')
      infisical_name_count=$(printf '%s' "$infisical_names" | grep -c '' || :)
      case $(printf '%s' "$infisical_secrets" | tr -d '[:space:]') in
        "" | "[]" | null)
          echo "Infisical folder $infisical_path returned no secrets; check the folder, environment and the identity's role." >&2
          infisical_refused=1
          continue
          ;;
        *)
          if [ "$infisical_name_count" -eq 0 ] ||
            [ "$(infisical_count "$infisical_secrets" '"key"[[:space:]]*:')" -ne "$infisical_name_count" ] ||
            [ "$(infisical_count "$infisical_secrets" '"value"[[:space:]]*:')" -ne "$infisical_name_count" ]; then
            echo "Could not read the secret names in Infisical folder $infisical_path from the CLI's output." >&2
            infisical_refused=1
            continue
          fi
          ;;
      esac
      infisical_rejected=""
      while IFS= read -r name; do
        infisical_allowed_name "$name" || infisical_rejected="$infisical_rejected ${name:-(empty)}"
      done <<NAMES
$(printf '%s\n' "$infisical_names" | sort -u)
NAMES
      if [ -n "$infisical_names" ] && [ -n "$infisical_rejected" ]; then
        echo "Infisical folder $infisical_path holds names that must stay host variables or be removed:$infisical_rejected" >&2
        infisical_refused=1
      fi
    done
    unset infisical_secrets
    if [ "$infisical_refused" -eq 1 ]; then exit 1; fi

    export INFISICAL_SECRETS_LOADED=1
    infisical_digest=$(infisical_env_digest)
    infisical_digest_usable "$infisical_digest"
    # shellcheck disable=SC2086
    exec infisical run $infisical_project_args $infisical_path_args -- "$0" --infisical-env-digest="$infisical_digest" "$@"
  fi
fi

unset INFISICAL_TOKEN INFISICAL_UNIVERSAL_AUTH_CLIENT_ID INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET
